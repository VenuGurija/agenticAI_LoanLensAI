LOANLENS_ENV=development
LOANLENS_DATABASE_URL=sqlite:///./data/loanlens.db
LOANLENS_TMP_DIR=data/tmp/images
LOANLENS_MAX_IMAGES_PER_ANALYSIS=12
LOANLENS_MAX_IMAGE_BYTES=10485760
LOANLENS_ANALYSIS_TTL_HOURS=24
VISION_PROVIDER=fake
# Server-only. Leave this empty. A real key belongs in .env, which is gitignored — never in git, logs, or API responses.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
LOANLENS_LOG_LEVEL=INFO
LOANLENS_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
VITE_API_BASE_URL=http://127.0.0.1:8002
# true: the API process runs one queued draft at a time. false: drafts stay queued.
LOANLENS_WORKER_ENABLED=true
# Maximum seconds for one vision HTTP call. Default 60. Returns when the provider completes. CPU Ollama example: 1200. Does not block Analyze.
LOANLENS_VISION_TIMEOUT_SECONDS=60
